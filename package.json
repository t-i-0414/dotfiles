{
  "name": "dotfiles",
  "private": true,
  "scripts": {
    "check": "run-p check:*",
    "check:format": "prettier --check .",
    "check:markdown": "markdownlint-cli2 --config node_modules/dev-config/base.markdownlint-cli2.jsonc \"**/*.md\"",
    "check:package-json": "npmPkgJsonLint --configFile node_modules/dev-config/base.npmpackagejsonlintrc.json \"**/package.json\"",
    "check:secrets": "secretlint --secretlintrc node_modules/dev-config/base.secretlintrc.json --secretlintignore node_modules/dev-config/base.secretlintignore \"**/*\"",
    "check:spell": "cspell --no-progress \"**\""
  },
  "devDependencies": {
    "dev-config": "github:takudev-works/dev-config#v3.0.0"
  },
  "prettier": "dev-config/base.prettierrc.json"
}
